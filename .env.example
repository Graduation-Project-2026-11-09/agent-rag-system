# コピーして .env を作成する（.env は Git に含めない）
#   cp .env.example .env

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

SECRET_KEY=dev-secret-change-me

# 各自で発行したキーを設定する。チャットや Issue に貼らないこと
OPENAI_API_KEY=

# 使用するモデル（docs/architecture/ai.md）。未設定なら下の値になる
# OPENAI_CHAT_MODEL_FAST=gpt-6-luna
# OPENAI_CHAT_MODEL_ANSWER=gpt-6-luna
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# `flask seed-users` で登録するダミー利用者のパスワード（開発環境のみ）
SEED_USER_PASSWORD=password123
